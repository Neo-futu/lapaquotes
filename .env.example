# local app (deadpool-postgres / config crate: PG__URL)
PG__URL=postgresql://postgres:postgres@127.0.0.1:5432/lapa

# agent — see doc/agent.md
# LLM_PROVIDER=cursor        # auto | openai | openrouter | cursor
# auto prefers Cursor when CURSOR_API_KEY is set. Chat UI defaults to Cursor.

# Cursor Cloud Agents (crsr_… from cursor.com/dashboard → API Keys):
# CURSOR_API_KEY=crsr_...
# CURSOR_MODEL=auto-smart

# OpenRouter (recommended) or any OpenAI-compatible API:
# OPENAI_API_KEY=sk-or-v1-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Default model (Chat UI can override). gpt-4o-mini may be geo-blocked:
# OPENAI_MODEL=deepseek/deepseek-chat
# Cheaper alternatives: mistralai/mistral-nemo | qwen/qwen-2.5-7b-instruct
# AGENT_MAX_TURNS=4
# AGENT_MAX_TOKENS=4096
# AGENT_ADDR=127.0.0.1:4151

# Feishu app (bot webhook — optional; separate from bitable personal token)
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_VERIFICATION_TOKEN=
# FEISHU_API_BASE=https://open.feishu.cn
#
# Feishu Bitable BI（仅三项；TABLE_ID/VIEW_ID/NAME 由 agent/bi 发现后写入 BiBitable*）
# FEISHU_BITABLE_ACCESS_TOKEN=pt-...
# FEISHU_BITABLE_APP_TOKEN=O563bA6LkakSfmsTU0ScIWNFn3g
# FEISHU_BITABLE_API_BASE=https://base-api.feishu.cn
# Apply BI tables: python scripts/bi/apply_schema.py
# Daily sync:      python scripts/bi/daily_sync.py
# CLI:             cargo run -p agent --example bi_sync --features standalone -- daily

# WhatsApp Cloud API (Meta) — webhook: https://<host>/agent/channels/whatsapp/webhook
# Create app at developers.facebook.com → WhatsApp → configure webhook (messages).
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=choose-a-secret-string
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_ALLOWED_FROM=85291234567   # optional allowlist (digits, no +)

# Optional Rig MCP client (remote tools for the LLM). Channels do not use this.
# cargo check -p agent --features mcp
# MCP_ENABLED=0
# MCP_TRANSPORT=stdio
# MCP_SERVER_CMD=
# MCP_SERVER_ARGS=

# OTC quotes are populated by an external Python email-ingestion script — see
# doc/ingestion.md for the table schema and idempotent upsert contract.

# used for ./ops scripts
TARGET="aarch64-unknown-linux-gnu"
SERVER_HOST="sozu@server"
SERVER_DIR="/home/sozu/lapa"
SITE_BIN="site"
ADMIN_BIN="admin"
CLI_BIN="cli"
SITE_DOMAIN="lapa.chepura.space"
ADMIN_DOMAIN="lapa-admin.chepura.space"
